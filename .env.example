# Deployer wallet private key (TESTNET ONLY — never commit a real .env)
PRIVATE_KEY=
# e.g. https://sepolia.base.org or an Alchemy/Infura Base Sepolia URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Etherscan V2 API key (works for Basescan) — used by `hardhat verify`
BASESCAN_API_KEY=
# Address (public, not key) of the backend claim signer. Placeholder OK until backend is ready.
CLAIM_SIGNER_ADDRESS=

# Optional
# BASE_RPC_URL=https://mainnet.base.org   # mainnet config only; deploy script refuses mainnet unless ALLOW_MAINNET_DEPLOY=true
# HARDHAT_USE_SOLCJS=true                 # compile with the bundled solcjs instead of downloading solc
# REPORT_GAS=true
